---
// LA CARTE DU PORTAIL : le cube se brise, et ses éclats forment une carte du site.
// Elle occupe tout l'écran : un noyau au centre, des orbites, et les cinq
// destinations posées en rond autour de lui, à intervalles réguliers. (Le CV n'y
// est plus depuis le 16 octobre 2026 : il se télécharge depuis la barre du haut,
// le menu d'identité et la visite rapide.)
//
// Ce fichier ne contient que ce qui se lit et se clique : le titre, le bouton
// de fermeture, le noyau et les cinq liens. Tout le reste (les éclats de verre,
// les orbites, la poussière d'étoiles) est dessiné sur la toile par
// src/scripts/explorateur.ts, qui place aussi chaque lien à sa position.
//
// C'est le seul moyen de changer de destination (avec la recherche, et les liens
// directs de l'accueil) : on la rejoint par le passage en bas de chaque destination.
import { SECTIONS } from '../contenu';
import type { Contenu } from '../contenu/types';
import Symbole from './Symbole.astro';

interface Props {
  contenu: Contenu;
}

const { contenu: c } = Astro.props;

// De quel côté de son point s'écrit le nom de chaque destination. Elles sont
// posées en rond, dans le sens des aiguilles d'une montre, la première en haut.
const COTES = ['haut', 'droite', 'bas', 'bas', 'gauche'];
// Les nombres cités dans les descriptions viennent du contenu réel.
const nombres: Record<string, number> = { competences: c.competences.domaines.length, realisations: c.realisations.projets.length };
const decrire = (id: keyof Contenu['explorateur']['destinations']) => c.explorateur.destinations[id].replace('{n}', String(nombres[id] ?? ''));
---

<dialog class="explorateur toujours-sombre" aria-labelledby="explorateur-titre" data-lenis-prevent>
  <canvas class="explorateur__toile" aria-hidden="true"></canvas>

  <header class="explorateur__tete etiquette">
    <h2 id="explorateur-titre">{c.explorateur.titre}</h2>
    <button class="pastille explorateur__fermer" type="button">{c.interface.fermer}</button>
  </header>

  <!-- Le noyau de la carte : le symbole du site. Un clic dessus referme la carte. -->
  <button class="explorateur__noyau" type="button" aria-label={c.explorateur.refermer} title={c.explorateur.refermer}>
    <Symbole taille={30} />
  </button>

  <nav class="explorateur__astres" aria-label={c.explorateur.titre}>
    {
      SECTIONS.map((id, i) => (
        <a class="astre" href={`#${id}`} data-destination={id} data-cote={COTES[i]} style={`--i: ${i}`}>
          <i aria-hidden="true" />
          <span class="astre__texte">
            <b>{c.sections[id]}</b>
            <small>{decrire(id)}</small>
            <em class="etiquette">{c.explorateur.ici}</em>
          </span>
        </a>
      ))
    }
  </nav>

  <p class="explorateur__aide etiquette">{c.explorateur.aide}</p>
</dialog>
