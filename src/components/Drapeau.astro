---
// Un petit drapeau rond, dessiné en SVG : France ou Royaume-Uni.
// Il indique la langue affichée ; le bouton qui le contient bascule vers l'autre.
import type { Langue } from '../contenu/types';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
---

{
  langue === 'fr' ? (
    <svg class="drapeau" viewBox="0 0 18 18" aria-hidden="true">
      <rect width="6" height="18" fill="#1f4fb2" />
      <rect x="6" width="6" height="18" fill="#f3f4f6" />
      <rect x="12" width="6" height="18" fill="#e0353c" />
    </svg>
  ) : (
    <svg class="drapeau" viewBox="0 0 18 18" aria-hidden="true">
      <rect width="18" height="18" fill="#1b3a8c" />
      <path d="M0 0 18 18M18 0 0 18" stroke="#f3f4f6" stroke-width="3.4" />
      <path d="M0 0 18 18M18 0 0 18" stroke="#d92f36" stroke-width="1.3" />
      <path d="M9 0v18M0 9h18" stroke="#f3f4f6" stroke-width="5.2" />
      <path d="M9 0v18M0 9h18" stroke="#d92f36" stroke-width="3" />
    </svg>
  )
}
