<!-- PORTAL RUSH (Unity) — LE DÉFI DU JOUR (Scripts/Interface/EcranDefi.cs). -->
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="defi" class="ecran ecran--defi" picking-mode="Ignore">
        <ui:VisualElement class="ecran__tete" picking-mode="Ignore">
            <ui:Label text="DLY · 03" class="etiquette ecran__module" />
            <ui:Label name="defi-titre" class="ecran__titre" />
            <ui:Label name="defi-date" class="etiquette ecran__sous defi__date" />
        </ui:VisualElement>
        <ui:VisualElement class="defi__corps" picking-mode="Ignore">
            <ui:VisualElement class="defi__gauche plaque">
                <ui:VisualElement name="defi-vue" class="defi__vue" picking-mode="Ignore" />
                <ui:VisualElement name="defi-regles" class="defi__regles" />
            </ui:VisualElement>
            <ui:VisualElement class="defi__droite" picking-mode="Ignore">
                <ui:VisualElement class="defi__resultat plaque">
                    <ui:Label name="defi-meilleur-libelle" class="etiquette" />
                    <ui:Label name="defi-meilleur" class="defi__valeur" />
                </ui:VisualElement>
                <ui:VisualElement class="defi__resultat plaque">
                    <ui:Label name="defi-derniere-libelle" class="etiquette" />
                    <ui:Label name="defi-derniere" class="defi__valeur defi__valeur--petite" />
                </ui:VisualElement>
                <ui:Label name="defi-note" class="defi__note" />
                <ui:Button name="defi-lancer" class="lancer plaque">
                    <ui:Label name="defi-lancer-texte" class="lancer__texte" picking-mode="Ignore" />
                    <ui:VisualElement class="icone icone--chevron lancer__icone" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
